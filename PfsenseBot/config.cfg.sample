[bot]
# Discord Bot Token
token = "your-discord-bot-token"
# Channel ID for alerts
channel_id = 0
# Admin User ID for mentions
admin_id = 0

[pfsense]
# Host IP or FQDN of your pfSense firewall
host = "router-ip-address"
# API Credentials
user = "your-username"
token = "pfsense-token"
# Verify SSL Certificates (set to true if you have valid certs)
verify_ssl = false

[ip_services]
# Services to check public IP (tried in order)
urls = [
    "https://api.ipify.org?format=json",
    "https://myip.wtf/json",
    "https://ifconfig.me/all.json"
]